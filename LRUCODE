cache_size = int(input("Enter cache size: "))
n = int(input("Enter number of references: "))

reference_string = list(map(int, input("Enter reference string: ").split()))

cache = []
hit = 0
miss = 0

print("\nLRU Cache Simulation\n")

for page in reference_string:
    if page in cache:
        hit += 1
        cache.remove(page)
        cache.append(page)   # Most recently used
        print(f"{page} → HIT  | Cache: {cache}")
    else:
        miss += 1
        if len(cache) == cache_size:
            cache.pop(0)     # Least recently used
        cache.append(page)
        print(f"{page} → MISS | Cache: {cache}")

hit_ratio = hit / n

print("\nTotal Hits   :", hit)
print("Total Misses:", miss)
print("Hit Ratio   :", round(hit_ratio, 2))
